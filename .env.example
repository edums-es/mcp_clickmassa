# ─── ClickMassa MCP — Configuração ─────────────────────────────────────────
#
# Copie este arquivo para .env e preencha com suas credenciais.
# NUNCA commite o .env no repositório.

# URL base da sua instância ClickMassa
# Formato: https://enterprise-40api.SEUDOMINIO.com.br
CLICKMASSA_BASE_URL=https://enterprise-40api.seudominio.com.br

# Token Bearer gerado em Configurações → API/Webhook na ClickMassa
CLICKMASSA_TOKEN=seu_token_aqui

# ID do canal (API/Webhook) usado para envio de mensagens
# Encontrado em Configurações → API/Webhook → clique no canal → copie o ID da URL
CLICKMASSA_CANAL_ID=seu_canal_id_aqui
